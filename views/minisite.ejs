<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= client.name %> · Pekelink</title>
  <style>
    :root {
      --accent: <%= client.theme || '#111827' %>;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: linear-gradient(160deg, var(--accent) 0%, #000 100%);
      color: #fff;
      display: flex;
      justify-content: center;
    }
    .wrap {
      width: 100%;
      max-width: 480px;
      padding: 48px 24px 64px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(255,255,255,0.8);
      background: rgba(255,255,255,0.1);
      margin-bottom: 16px;
    }
    h1 { font-size: 1.4rem; margin: 8px 0 4px; }
    .bio { opacity: 0.85; font-size: 0.95rem; margin-bottom: 32px; max-width: 360px; }
    .links { width: 100%; display: flex; flex-direction: column; gap: 14px; }
    .link-btn {
      display: block;
      width: 100%;
      padding: 16px 20px;
      border-radius: 14px;
      background: rgba(255,255,255,0.12);
      backdrop-filter: blur(6px);
      color: #fff;
      text-decoration: none;
      font-weight: 600;
      font-size: 1rem;
      border: 1px solid rgba(255,255,255,0.25);
      transition: transform 0.15s ease, background 0.15s ease;
    }
    .link-btn:hover { transform: translateY(-2px); background: rgba(255,255,255,0.22); }
    footer { margin-top: 48px; font-size: 0.75rem; opacity: 0.6; }
    footer a { color: inherit; }
  </style>
</head>
<body>
  <div class="wrap">
    <img class="avatar" src="<%= client.avatar || '/avatars/default.png' %>" alt="<%= client.name %>" />
    <h1><%= client.name %></h1>
    <% if (client.bio) { %><p class="bio"><%= client.bio %></p><% } %>
    <div class="links">
      <% (client.links || []).forEach(function(link) { %>
        <a class="link-btn" href="<%= link.url %>" target="_blank" rel="noopener"><%= link.label %></a>
      <% }); %>
    </div>
    <footer>hecho con <a href="https://pekelink.com">Pekelink</a></footer>
  </div>
</body>
</html>
